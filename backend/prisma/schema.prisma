generator client {
  provider = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CrewRole {
  PHOTOGRAPHER
  VIDEOGRAPHER
  DRONE_OPERATOR
  EDITOR
  ASSISTANT
}

enum EventStatus {
  INQUIRY
  CONFIRMED
  DONE
  CANCELLED
}

enum EventType {
  WEDDING
  BIRTHDAY
  DEBUT
  CORPORATE
  CHRISTENING
  OTHER
}

enum ConfirmationStatus {
  PENDING
  CALLED
  CONFIRMED
  DECLINED
  NO_ANSWER
  CANCELLED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Client {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  phone     String
  email     String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  events    Event[]

  @@index([name])
  @@map("clients")
}

model Freelancer {
  id               String                     @id @default(uuid()) @db.Uuid
  fullName         String                     @map("full_name")
  phone            String
  roles            CrewRole[]
  skills           String[]
  dailyRate        Decimal                    @map("daily_rate") @db.Decimal(10, 2)
  city             String
  latitude         Float?
  longitude        Float?
  isActive         Boolean                    @default(true) @map("is_active")
  notes            String?
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")
  unavailabilities FreelancerUnavailability[]
  assignments      Assignment[]

  @@index([city, isActive])
  @@index([isActive])
  @@map("freelancers")
}

model FreelancerUnavailability {
  id           String     @id @default(uuid()) @db.Uuid
  freelancerId String     @map("freelancer_id") @db.Uuid
  startDate    DateTime   @map("start_date")
  endDate      DateTime   @map("end_date")
  reason       String?
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@index([freelancerId, startDate, endDate])
  @@map("freelancer_unavailability")
}

model Event {
  id              String          @id @default(uuid()) @db.Uuid
  title           String
  clientId        String          @map("client_id") @db.Uuid
  eventType       EventType       @map("event_type")
  status          EventStatus     @default(INQUIRY)
  startAt         DateTime        @map("start_at")
  endAt           DateTime        @map("end_at")
  venueName       String          @map("venue_name")
  venueCity       String          @map("venue_city")
  venueLatitude   Float?          @map("venue_latitude")
  venueLongitude  Float?          @map("venue_longitude")
  guestCount      Int             @map("guest_count")
  hoursCovered    Float           @map("hours_covered")
  packageName     String?         @map("package_name")
  specialRequests String?         @map("special_requests")
  quotedPrice     Decimal?        @map("quoted_price") @db.Decimal(12, 2)
  estimatedBudget Decimal?        @map("estimated_budget") @db.Decimal(12, 2)
  actualCost      Decimal?        @map("actual_cost") @db.Decimal(12, 2)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  positions       EventPosition[]
  assignments     Assignment[]

  @@index([clientId, status])
  @@index([startAt, endAt])
  @@index([venueCity])
  @@map("events")
}

model EventPosition {
  id            String       @id @default(uuid()) @db.Uuid
  eventId       String       @map("event_id") @db.Uuid
  role          CrewRole
  requiredCount Int          @default(1) @map("required_count")
  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments   Assignment[]

  @@index([eventId, role])
  @@map("event_positions")
}

model Assignment {
  id           String             @id @default(uuid()) @db.Uuid
  eventId      String             @map("event_id") @db.Uuid
  freelancerId String             @map("freelancer_id") @db.Uuid
  positionId   String             @map("position_id") @db.Uuid
  status       ConfirmationStatus @default(PENDING)
  agreedRate   Decimal            @map("agreed_rate") @db.Decimal(10, 2)
  rating       Int?
  ratingNote   String?            @map("rating_note")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  freelancer   Freelancer         @relation(fields: [freelancerId], references: [id], onDelete: Restrict)
  position     EventPosition      @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([eventId, freelancerId])
  @@index([freelancerId, status])
  @@index([eventId, status])
  @@map("assignments")
}
